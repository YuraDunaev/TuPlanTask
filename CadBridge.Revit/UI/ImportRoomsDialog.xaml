<Window x:Class="CadBridge.Revit.UI.ImportRoomsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CadBridge — Import Rooms" Width="820" Height="540"
        MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResizeWithGrip"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CadBridge.Revit;component/UI/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Window.Background}"
            BorderBrush="{DynamicResource Brush.Border.Strong}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />   
                <RowDefinition Height="*" />    
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                           FontSize="{DynamicResource Font.Size.Header}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Text="Import Rooms" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Width="34" Height="26"
                        Style="{StaticResource Button.Base}"
                        Click="OnCloseClick" ToolTip="Close">
                    <Path Data="M 0 0 L 10 10 M 10 0 L 0 10"
                          Stroke="{DynamicResource Brush.Text.Primary}"
                          StrokeThickness="1.5" />
                </Button>
            </Grid>
            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                    Background="{DynamicResource Brush.Border}" />

            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   
                    <RowDefinition Height="Auto" />   
                    <RowDefinition Height="*" />      
                    <RowDefinition Height="Auto" />   
                    <RowDefinition Height="Auto" />   
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="File:" VerticalAlignment="Center"
                       FontSize="{DynamicResource Font.Size.Body}"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="8,4" VerticalAlignment="Center"
                         Height="{DynamicResource Control.Height}"
                         Padding="{DynamicResource Padding.Field}"
                         FontFamily="{DynamicResource Font.UI}"
                         FontSize="{DynamicResource Font.Size.Body}"
                         Style="{StaticResource TextBox.Dark}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="0" Grid.Column="2" Margin="6,4,0,4" MinWidth="92"
                        Height="{DynamicResource Control.Height}"
                        Content="Browse…" Command="{Binding BrowseCommand}" />

                <Label Grid.Row="1" Grid.Column="0" Content="Level:" VerticalAlignment="Center"
                       FontSize="{DynamicResource Font.Size.Body}"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,4"
                          Height="{DynamicResource Control.Height}"
                          Padding="{DynamicResource Padding.Field}"
                          FontFamily="{DynamicResource Font.UI}"
                          FontSize="{DynamicResource Font.Size.Body}"
                          ItemsSource="{Binding Levels}"
                          SelectedItem="{Binding SelectedLevel, Mode=TwoWay}" />

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Control}">
                    <DataGrid ItemsSource="{Binding Rooms}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HorizontalAlignment="Stretch"
                              CanUserAddRows="False" HeadersVisibility="Column"
                              SelectionUnit="FullRow" SelectionMode="Single">
                        
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=OneWay}" Width="Auto" />
                            <DataGridTextColumn Header="Number" Binding="{Binding Number, Mode=OneWay}" Width="Auto" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="Area (m²)" Binding="{Binding Area, Mode=OneWay, StringFormat=N2}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right" />
                                        <Setter Property="Padding" Value="0,0,8,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="Auto"
                                                CellStyle="{StaticResource DataGridCell.Status}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="2,10"
                           FontSize="{DynamicResource Font.Size.Body}"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           Text="{Binding Summary, Mode=OneWay}" />

                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                            Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button MinWidth="120" Height="{DynamicResource Control.Height}" Margin="0,0,10,0"
                            FontSize="{DynamicResource Font.Size.Body}"
                            Style="{StaticResource Button.Primary}"
                            Content="Import" Command="{Binding ImportCommand}" />
                    <Button MinWidth="120" Height="{DynamicResource Control.Height}"
                            FontSize="{DynamicResource Font.Size.Body}"
                            Content="Cancel" Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>


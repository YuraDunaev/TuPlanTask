
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <FontFamily x:Key="Font.UI">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas</FontFamily>
    <sys:Double x:Key="Font.Size.Body">14</sys:Double>
    <sys:Double x:Key="Font.Size.Caption">12.5</sys:Double>
    <sys:Double x:Key="Font.Size.Header">16</sys:Double>
    
    <sys:Double x:Key="Font.Size.Mono">12</sys:Double>

    <Color x:Key="Color.Window.Background">#1F1F1F</Color>
    <Color x:Key="Color.Surface">#252526</Color>
    <Color x:Key="Color.Surface.Hover">#2A2D2E</Color>
    <Color x:Key="Color.Surface.Selected">#04395E</Color>
    <Color x:Key="Color.Control">#3A3D41</Color>
    <Color x:Key="Color.Control.Hover">#45494E</Color>
    <Color x:Key="Color.Control.Pressed">#2F3134</Color>
    <Color x:Key="Color.Border">#3F3F46</Color>
    <Color x:Key="Color.Border.Strong">#454545</Color>
    <Color x:Key="Color.Focus">#0078D4</Color>
    <Color x:Key="Color.Text.Primary">#CCCCCC</Color>
    <Color x:Key="Color.Text.Muted">#9D9D9D</Color>
    <Color x:Key="Color.Text.Disabled">#656565</Color>
    <Color x:Key="Color.Text.Inverse">#FFFFFF</Color>
    <Color x:Key="Color.Accent">#0E639C</Color>
    <Color x:Key="Color.Accent.Hover">#1177BB</Color>
    <Color x:Key="Color.Success">#89D185</Color>
    <Color x:Key="Color.Warning">#D7BA7D</Color>
    <Color x:Key="Color.Error">#F48771</Color>
    <Color x:Key="Color.Grid.Header">#2D2D30</Color>
    <Color x:Key="Color.Grid.RowAlt">#242424</Color>
    <Color x:Key="Color.Grid.Line">#555555</Color>
    
    <SolidColorBrush x:Key="Brush.Window.Background" Color="{StaticResource Color.Window.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}" />
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="{StaticResource Color.Surface.Selected}" />
    <SolidColorBrush x:Key="Brush.Control" Color="{StaticResource Color.Control}" />
    <SolidColorBrush x:Key="Brush.Control.Hover" Color="{StaticResource Color.Control.Hover}" />
    <SolidColorBrush x:Key="Brush.Control.Pressed" Color="{StaticResource Color.Control.Pressed}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}" />
    <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Brush.Text.Inverse" Color="{StaticResource Color.Text.Inverse}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.Grid.Header" Color="{StaticResource Color.Grid.Header}" />
    <SolidColorBrush x:Key="Brush.Grid.RowAlt" Color="{StaticResource Color.Grid.RowAlt}" />
    <SolidColorBrush x:Key="Brush.Grid.Line" Color="{StaticResource Color.Grid.Line}" />

    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Window">8</CornerRadius>
    <Thickness x:Key="Padding.Control">12,9</Thickness>
    
    <Thickness x:Key="Padding.Field">10,2</Thickness>
    <sys:Double x:Key="Control.Height">44</sys:Double>
    <sys:Double x:Key="Grid.RowHeight">48</sys:Double>
    <Thickness x:Key="Grid.CellPadding">12,4</Thickness>

</ResourceDictionary>


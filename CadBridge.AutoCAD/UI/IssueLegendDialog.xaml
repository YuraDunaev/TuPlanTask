<Window x:Class="CadBridge.AutoCAD.UI.IssueLegendDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CadBridge — Легенда маркеров" Width="640" Height="460"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResizeWithGrip"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CadBridge.AutoCAD;component/UI/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Window.Background}"
            BorderBrush="{DynamicResource Brush.Border.Strong}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                           FontSize="{DynamicResource Font.Size.Header}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Text="Легенда маркеров" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Width="34" Height="26"
                        Style="{StaticResource Button.Base}"
                        Click="OnCloseClick" ToolTip="Close">
                    <Path Data="M 0 0 L 10 10 M 10 0 L 0 10"
                          Stroke="{DynamicResource Brush.Text.Primary}"
                          StrokeThickness="1.5" />
                </Button>
            </Grid>
            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                    Background="{DynamicResource Brush.Border}" />

            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Control}">
                    <DataGrid x:Name="LegendGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HorizontalAlignment="Stretch" RowHeight="36"
                              CanUserAddRows="False" HeadersVisibility="Column"
                              SelectionUnit="FullRow" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Маркер" Binding="{Binding Marker, Mode=OneWay}" Width="80" />
                            <DataGridTextColumn Header="Метка" Binding="{Binding Label, Mode=OneWay}" Width="90" />
                            <DataGridTextColumn Header="Пояснение" Binding="{Binding Description, Mode=OneWay}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock x:Name="EmptyText" Grid.Row="0" Visibility="Collapsed"
                           Margin="4" TextAlignment="Center" VerticalAlignment="Center"
                           FontSize="{DynamicResource Font.Size.Body}"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           Text="Маркеров нет. Запустите UPDATEROOMS, чтобы разметить расхождения." />

                <TextBlock Grid.Row="1" Margin="2,10"
                           FontSize="{DynamicResource Font.Size.Body}"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           Text="Маркеры нумеруются сверху вниз, слева направо. Пересчёт — UPDATEROOMS." />

                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button MinWidth="120" Height="{DynamicResource Control.Height}"
                            FontSize="{DynamicResource Font.Size.Body}"
                            Style="{StaticResource Button.Primary}"
                            Content="Закрыть" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
